# ---- Dependencies ----
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]

# ---- Build output / artifacts ----
dist/
**/dist/
build/
*.tsbuildinfo

# ---- Test / tooling caches ----
.pytest_cache/
**/.pytest_cache/
.hypothesis/
**/.hypothesis/
coverage/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3

# ---- Local private image storage (original bytes volume) ----
# The private original-bytes volume lives at backend/var/storage (STORAGE_ROOT),
# covered by the backend/var/ rule below. Also ignore a root-level storage/ data
# dir. NEVER ignore the application source package backend/app/storage/.
/storage/
*.local-storage/
!backend/app/storage/
!backend/app/storage/*.py
# (bytecode under the source package stays ignored by the __pycache__ rule)

# ---- Secrets / environment ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# ---- OS / editor cruft ----
.DS_Store
*.log
Thumbs.db

# ---- Kiro transient / session data (not source) ----
.kiro/sessions/
**/tasks.meta.json

# ---- Backend local dev DB and private storage volume ----
backend/local.db
backend/var/
alembic_tmp.db
**/alembic_tmp.db
